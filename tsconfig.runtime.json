{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "typeRoots": ["./types", "./node_modules/@types", "./app/node_modules/@types"]
  },
  "include": [
    "app/src/**/*.js",
    "bluetooth/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules"
  ]
}
